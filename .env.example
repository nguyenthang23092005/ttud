# Runtime
APP_ENV=development
LOG_LEVEL=INFO
RANDOM_SEED=42

# OSM graph
OSM_PLACE=Hanoi, Vietnam
OSM_VEHICLE_PROFILE=car
OSM_SIMPLIFY=true
OSM_RETAIN_ALL=false
OSM_TRUNCATE_BY_EDGE=true
OSM_REQUEST_TIMEOUT_SECONDS=180
OSM_CACHE_DIR=data/graph

# Traffic integration (later phases). Never commit real keys.
TRAFFIC_PROVIDER=synthetic
TOMTOM_API_KEY=
HERE_API_KEY=

